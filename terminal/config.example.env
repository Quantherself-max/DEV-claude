# Le plus simple : lance le terminal et utilise le bouton "Reglages" (il cree et remplit ce fichier pour toi).
# Sinon : copie ce fichier en ".env" (meme dossier) et ajuste. Ne le partage jamais : il contient ton token Telegram.

# binance = donnees reelles (Binance futures, sans cle ni compte) | simulated = prix fictifs (essai sans internet)
TERMINAL_SOURCE=binance
TERMINAL_SYMBOLS=BTCUSDT,SOLUSDT

# Alertes Telegram : cree un bot avec @BotFather (/newbot) -> token ; puis ecris un message a ton bot et
# clique "Trouver mon chat id" dans les Reglages (ou lance : python run.py --telegram-chatid)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Regles d'alerte (valeurs par defaut)
TERMINAL_ALERT_TF=1h
TERMINAL_ALERT_MIN_SCORE=3
TERMINAL_ALERT_COOLDOWN_HOURS=6
# ideas = tu ne recois QUE les idees de trade (defaut) | all = + alertes de zones, de poches balayees et d'annonces
TERMINAL_ALERT_MODE=ideas
# (mode all) alertes de zones « nouvelle confluence » / « le prix approche » (1 = oui, 0 = non)
TERMINAL_ALERT_ZONES=1
# alerte quand une grosse poche de liquidation est balayee (1 = oui, 0 = non)
TERMINAL_ALERT_SWEEP=1

# Probabilites : rebond = +k ATR (1h) avant -k ATR dans l'horizon (heures)
TERMINAL_STATS_K=1.5
TERMINAL_STATS_HORIZON=24

# Annonces macro : alerte ~1 h avant une annonce majeure + bilan de la reaction du marche (1 = oui, 0 = non)
TERMINAL_ALERT_MACRO=1

# Latence : secondes entre deux recalculs des niveaux / alertes (le prix, lui, arrive en temps reel)
TERMINAL_REFRESH_SECONDS=5
# Flux temps reel serveur (prix exact pour les alertes + vraies liquidations) : 1 = oui, 0 = non
TERMINAL_LIVE_WS=1

# Historique d'analyse : annees de bougies 1h chargees (0 = le plus long possible, depuis sept. 2019). 2 ou 3 = demarrage plus leger
TERMINAL_HISTORY_YEARS=0

# Idees de trade (Telegram) : rares, de haute qualite, avec stop et objectifs ; au plus N par semaine (lundi 00:00 UTC)
TERMINAL_SIGNALS=1
TERMINAL_SIGNAL_MIN_SCORE=60
TERMINAL_SIGNAL_MAX_WEEK=5
TERMINAL_SIGNAL_MIN_STRUCT=7
# ton levier habituel : sert uniquement au calcul de liquidation affiche dans chaque idee
TERMINAL_SIGNAL_LEVERAGE=10
TERMINAL_SIGNAL_VALID_HOURS=48
# sens des idees : both = achats et ventes (recommande ; jamais deux biais opposes a moins de 24 h, toutes paires confondues)
# | long = achat seulement (les configurations de vente deviennent des « alertes pour tes longs », hors quota) | short = vente seulement
TERMINAL_SIGNAL_DIRECTION=both

# Avis d'influenceurs sur X (facultatif, indicatif, jamais dans le score) : jeton d'acces X (API officielle) + comptes a suivre.
# La lecture est payante cote X (environ 0,005 $ par post lu) : elle n'a lieu qu'a l'envoi d'une idee. Ne partage jamais ce fichier.
TERMINAL_X_ON=1
TERMINAL_X_BEARER_TOKEN=
TERMINAL_X_ACCOUNTS=
TERMINAL_X_POSTS=10

# Derives et donnees en chaine (lecture seule, sans cle) : options Deribit, financement / Open Interest Bybit-OKX-Hyperliquid, base des futures, jeux libres GitHub (1 = oui, 0 = non)
TERMINAL_DERIVS=1

# Mise a jour automatique (le plus simple : Reglages -> 6. Mises a jour). Une nouvelle version publiee sur GitHub est verifiee, sauvegardee, installee,
# et le terminal redemarre tout seul (la page du navigateur se recharge). Depot public : aucun jeton necessaire (jeton en lecture seule seulement s'il redevient prive).
TERMINAL_UPDATE_AUTO=1
TERMINAL_GITHUB_TOKEN=
# auto = la branche la plus recemment mise a jour qui contient le terminal ; sinon un nom de branche precis
TERMINAL_UPDATE_BRANCH=auto
TERMINAL_UPDATE_MINUTES=30

# Discussion avec Claude (le plus simple : Reglages -> 7). Tu poses tes questions sur Telegram (au meme bot) ou dans l'onglet Discussion ; Claude repond
# avec toutes les donnees du terminal. Cle API Anthropic (console.anthropic.com, payante a l'usage, distincte de l'abonnement Claude). Ne partage jamais ce fichier.
TERMINAL_ANTHROPIC_API_KEY=
# claude-opus-5-5 (defaut) | claude-sonnet-5-5 | claude-haiku-4-5
TERMINAL_CHAT_MODEL=claude-opus-5-5
TERMINAL_CHAT_WEB=1
TERMINAL_CHAT_TELEGRAM=1
# plafond de depense mensuelle en dollars (0 = sans plafond)
TERMINAL_CHAT_BUDGET=20
