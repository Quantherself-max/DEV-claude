# Copie ce fichier en ".env" (meme dossier) et ajuste. Ne le partage jamais : il contient ton token Telegram.

# simulated = donnees fictives (pour essayer) | binance = donnees reelles (Binance futures, sans cle)
TERMINAL_SOURCE=simulated
TERMINAL_SYMBOLS=BTCUSDT,SOLUSDT

# Alertes Telegram : cree un bot avec @BotFather (/newbot) -> token ; puis ecris un message a ton bot et lance
#   python run.py --telegram-chatid     -> te donne ton chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Regles d'alerte (valeurs par defaut)
TERMINAL_ALERT_TF=1h
TERMINAL_ALERT_MIN_SCORE=3
TERMINAL_ALERT_COOLDOWN_HOURS=6
