# Le plus simple : lance le terminal et utilise le bouton "Reglages" (il cree et remplit ce fichier pour toi).
# Sinon : copie ce fichier en ".env" (meme dossier) et ajuste. Ne le partage jamais : il contient ton token Telegram.

# binance = donnees reelles (Binance futures, sans cle ni compte) | simulated = prix fictifs (essai sans internet)
TERMINAL_SOURCE=binance
TERMINAL_SYMBOLS=BTCUSDT,SOLUSDT

# Alertes Telegram : cree un bot avec @BotFather (/newbot) -> token ; puis ecris un message a ton bot et
# clique "Trouver mon chat id" dans les Reglages (ou lance : python run.py --telegram-chatid)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Regles d'alerte (valeurs par defaut)
TERMINAL_ALERT_TF=1h
TERMINAL_ALERT_MIN_SCORE=3
TERMINAL_ALERT_COOLDOWN_HOURS=6
# alerte quand une grosse poche de liquidation est balayee (1 = oui, 0 = non)
TERMINAL_ALERT_SWEEP=1

# Probabilites : rebond = +k ATR (1h) avant -k ATR dans l'horizon (heures)
TERMINAL_STATS_K=1.5
TERMINAL_STATS_HORIZON=24

# Annonces macro : alerte ~1 h avant une annonce majeure + bilan de la reaction du marche (1 = oui, 0 = non)
TERMINAL_ALERT_MACRO=1

# Latence : secondes entre deux recalculs des niveaux / alertes (le prix, lui, arrive en temps reel)
TERMINAL_REFRESH_SECONDS=5
# Flux temps reel serveur (prix exact pour les alertes + vraies liquidations) : 1 = oui, 0 = non
TERMINAL_LIVE_WS=1
