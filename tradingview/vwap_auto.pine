//@version=6
indicator("VWAP Auto TF", "VWAP Auto", overlay = true, max_lines_count = 100, max_labels_count = 100)

// 0) Periode de reference (comme l'indicateur AVP) : Auto (Smart) choisit les periodes adaptees
//    au timeframe (Jour/Semaine/Mois jusqu'a 1h, Semaine/Mois/Annee a 2h-4h, Mois/Annee en 12h-1D),
//    ou une seule periode au choix, ou Tout. Elle pilote VWAP calendrier, Volume Profile et Opens.
// 1) VWAP principale : en Auto, TF <= 60m -> Jour | <= 4h -> Semaine | <= 1D -> Mois | sinon Annee.
// 2) VWAP calendrier : Weekly, cMonth, Yearly + une VWAP ancree a une date libre.
//    Une ligne identique a la VWAP principale n'est pas retracee (pas de doublon).
// 3) Volume Profile par periode (Jour, Semaine, Mois, Annee) : POC, HVN (pics de volume),
//    VAH / VAL de la periode precedente.
// 4) Opens Jour / Weekly / Monthly / Yearly (en crypto 24/7, l'open = la cloture precedente).
// 5) Tableau des confluences : zones ou plusieurs niveaux (sources differentes) se regroupent.
//    Fleche = sens ou le prix est attire (regle "aimant") : zone au-dessus = haussier,
//    zone en dessous = baissier. Regle de travail, pas une probabilite mesuree.
// Un niveau est masque si sa periode contient moins de N barres (profil peu fiable).
// VWAP = lignes pleines | Volume Profile = pointilles | Opens = traits horizontaux pleins.
// Periodes calendaires basees sur le fuseau de l'echange (UTC pour le crypto).

G1 = "Periode de reference et VWAP principale"
refMode = input.string("Auto (Smart)", "Periode de reference", group = G1,
     options = ["Auto (Smart)", "Jour", "Semaine", "Mois", "Annee", "Tout"])
src     = input.source(hlc3, "Source", group = G1)
col     = input.color(#FFB300, "Couleur", group = G1)
showBnd = input.bool(true, "Afficher les bandes +/- 1 ecart-type", group = G1)
k1      = input.float(1.0, "Bande (x ecart-type)", minval = 0.1, step = 0.1, group = G1)

G2 = "Seuils du mode Auto (TF du graphique, en minutes)"
dayMax   = input.int(60, "Jour si TF <=", minval = 1, group = G2)
weekMax  = input.int(240, "Semaine si TF <=", minval = 1, group = G2)
monthMax = input.int(1440, "Mois si TF <=", minval = 1, group = G2)
minBars  = input.int(20, "Masquer si moins de N barres dans la periode", minval = 1, group = G2)

G4 = "VWAP calendrier"
onW = input.bool(true, "Weekly", inline = "w", group = G4)
cW  = input.color(#4CAF50, "", inline = "w", group = G4)
onM = input.bool(true, "cMonth", inline = "m", group = G4)
cM  = input.color(#42A5F5, "", inline = "m", group = G4)
onY = input.bool(true, "Yearly", inline = "y", group = G4)
cY  = input.color(#EC407A, "", inline = "y", group = G4)
onD = input.bool(true, "VWAP ancree a une date", inline = "d", group = G4)
cD  = input.color(#E0E0E0, "", inline = "d", group = G4)
dT  = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Date ancrage", group = G4)
dNm = input.string("2024 VWAP", "Nom", group = G4)

G5 = "Volume Profile (POC / HVN / VAH / VAL)"
vaPct  = input.float(70.0, "Value Area (%)", minval = 10.0, maxval = 99.0, step = 1.0, group = G5)
binPct = input.float(0.10, "Taille de bin (% du prix)", minval = 0.03, maxval = 2.0, step = 0.01, group = G5)
vpLbl  = input.bool(true, "Afficher les noms (VP, HVN et Opens)", group = G5)
onVD   = input.bool(true, "Jour", inline = "vd", group = G5)
cVD    = input.color(#AB47BC, "", inline = "vd", group = G5)
onVW   = input.bool(true, "Weekly", inline = "vw", group = G5)
cVW    = input.color(#4CAF50, "", inline = "vw", group = G5)
onVM   = input.bool(true, "Monthly", inline = "vm", group = G5)
cVM    = input.color(#42A5F5, "", inline = "vm", group = G5)
onVY   = input.bool(true, "Yearly", inline = "vy", group = G5)
cVY    = input.color(#EC407A, "", inline = "vy", group = G5)
hvnN   = input.int(1, "HVN par profil (0 = aucun, max 2)", minval = 0, maxval = 2, group = G5)
hvnWin = input.float(1.0, "HVN : ecart min entre pics (% du prix)", minval = 0.2, maxval = 5.0,
     step = 0.1, group = G5)
hvnMin = input.float(50.0, "HVN : volume min (% du POC)", minval = 10.0, maxval = 100.0,
     step = 5.0, group = G5)
showHvn = input.bool(true, "Afficher les lignes HVN", group = G5)

G6 = "Opens de periode"
onOD = input.bool(true, "Jour open", inline = "od", group = G6)
cOD  = input.color(#CE93D8, "", inline = "od", group = G6)
onOW = input.bool(true, "Weekly open", inline = "ow", group = G6)
cOW  = input.color(#9CCC65, "", inline = "ow", group = G6)
onOM = input.bool(true, "Monthly open", inline = "om", group = G6)
cOM  = input.color(#64B5F6, "", inline = "om", group = G6)
onOY = input.bool(true, "Yearly open", inline = "oy", group = G6)
cOY  = input.color(#F06292, "", inline = "oy", group = G6)

G7 = "Tableau des confluences"
showTbl  = input.bool(true, "Afficher le tableau", group = G7)
tblPosIn = input.string("Haut droite", "Position", group = G7,
     options = ["Haut droite", "Haut gauche", "Bas droite", "Bas gauche"])
confAtr  = input.float(0.30, "Tolerance (x ATR)", minval = 0.05, step = 0.05, group = G7)
confMin  = input.float(0.15, "Tolerance minimale (% du prix)", minval = 0.01, step = 0.01, group = G7)

// Grille de prix du profil : bins logarithmiques de binPct % (de mintick a mintick x 1e9)
float lnStep = math.log(1.0 + binPct / 100.0)
float minPx  = syminfo.mintick
int lnBase   = int(math.floor(math.log(minPx) / lnStep))
int nBins    = int(math.ceil(math.log(1000000000.0) / lnStep)) + 2

string tblPos = switch tblPosIn
    "Haut gauche" => position.top_left
    "Bas droite"  => position.bottom_right
    "Bas gauche"  => position.bottom_left
    => position.top_right

var table cf = table.new(tblPos, 3, 7, border_width = 1, border_color = color.new(color.gray, 75),
     frame_width = 1, frame_color = color.new(color.gray, 75))
color cfBg = color.new(color.black, 15)
color cfPriceBg = color.new(color.gray, 70)

periodName(string tf) =>
    switch tf
        "D"  => "Jour"
        "W"  => "Semaine"
        "M"  => "Mois"
        "3M" => "Trimestre"
        => "Annee"

// VWAP remise a zero quand newP est vrai
curVwap(float s, bool newP) =>
    [v, u, d] = ta.vwap(s, newP, 1.0)
    v

// VWAP ancree a la premiere bougie dont l'heure >= t
dateVwap(float s, int t) =>
    bool hit = time >= t and nz(time[1]) < t
    [v, u, d] = ta.vwap(s, hit, 1.0)
    time >= t ? v : na

// Etiquette "nom prix" collee a la derniere bougie
tag(string nm, float lvl, color c, bool show) =>
    var label lb = na
    if barstate.islast
        label.delete(lb)
        if show and not na(lvl)
            lb := label.new(bar_index, lvl, nm + " " + str.tostring(lvl, "#.##"),
                 style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)

// Open de la periode en cours : trait horizontal prolonge a droite
openLine(string nm, float lvl, int x1, bool show, color c) =>
    var line ol = na
    var label olb = na
    if barstate.islast
        line.delete(ol)
        label.delete(olb)
        if show and not na(lvl)
            ol := line.new(x1, lvl, bar_index, lvl, extend = extend.right, color = c, width = 1)
            if vpLbl
                olb := label.new(bar_index, lvl, nm + " " + str.tostring(lvl, "#.##"),
                     style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
    true

// ---------------- Volume Profile : fonctions ----------------
idxOf(float p) =>
    int i = int(math.floor(math.log(math.max(p, minPx)) / lnStep)) - lnBase
    math.max(0, math.min(nBins - 1, i))

priceOf(int i, float off) =>
    math.exp((i + lnBase + off) * lnStep)

// Ajoute le volume d'une bougie, reparti uniformement entre son low et son high
vpAdd(array<float> bins, array<int> m, float l, float h, float vol) =>
    int a = idxOf(l)
    int b = idxOf(h)
    float share = vol / (b - a + 1)
    for i = a to b
        array.set(bins, i, array.get(bins, i) + share)
    array.set(m, 0, math.min(array.get(m, 0), a))
    array.set(m, 1, math.max(array.get(m, 1), b))
    true

// Remet le profil a zero (m = [bin min, bin max, barre de debut])
vpReset(array<float> bins, array<int> m, int startBar) =>
    int lo = array.get(m, 0)
    int hi = array.get(m, 1)
    if hi >= lo
        for i = lo to hi
            array.set(bins, i, 0.0)
    array.set(m, 0, nBins)
    array.set(m, 1, -1)
    array.set(m, 2, startBar)
    true

// POC, VAH, VAL (Value Area : on ajoute la paire de lignes la plus fournie, au-dessus ou en dessous)
vpStats(array<float> bins, array<int> m) =>
    int lo = array.get(m, 0)
    int hi = array.get(m, 1)
    float poc = na
    float vah = na
    float val = na
    if hi >= lo
        float tot = 0.0
        float best = -1.0
        int pocI = lo
        for i = lo to hi
            float v = array.get(bins, i)
            tot += v
            if v > best
                best := v
                pocI := i
        float acc = best
        float target = tot * vaPct / 100.0
        int up = pocI
        int dn = pocI
        while acc < target and (up < hi or dn > lo)
            float upV = 0.0
            float dnV = 0.0
            if up < hi
                upV := array.get(bins, up + 1)
                if up + 1 < hi
                    upV += array.get(bins, up + 2)
            if dn > lo
                dnV := array.get(bins, dn - 1)
                if dn - 1 > lo
                    dnV += array.get(bins, dn - 2)
            if up < hi and (dn <= lo or upV >= dnV)
                acc += upV
                up := math.min(hi, up + 2)
            else
                acc += dnV
                dn := math.max(lo, dn - 2)
        poc := priceOf(pocI, 0.5)
        vah := priceOf(up, 1.0)
        val := priceOf(dn, 0.0)
    [poc, vah, val]

// HVN : pics de volume du profil lisse, hors zone du POC (au plus hvnN) ; renvoie [prix 1, prix 2]
vpHvn(array<float> bins, array<int> m) =>
    int lo = array.get(m, 0)
    int hi = array.get(m, 1)
    float h1 = na
    float h2 = na
    int nb = hi - lo + 1
    int w = math.max(2, math.min(math.round(hvnWin / binPct), math.round(nb / 5.0)))
    int sr = math.max(1, math.round(w / 3.0))
    if hvnN > 0 and hi - lo >= 2 * w
        array<float> sm = array.new_float(nb, 0.0)
        for i = lo to hi
            float acc = 0.0
            int cnt = 0
            for j = math.max(lo, i - sr) to math.min(hi, i + sr)
                acc += array.get(bins, j)
                cnt += 1
            array.set(sm, i - lo, acc / cnt)
        float mx = 0.0
        int pk = 0
        for q = 0 to nb - 1
            float v0 = array.get(sm, q)
            if v0 > mx
                mx := v0
                pk := q
        float b1 = 0.0
        float b2 = 0.0
        int i1 = -1
        int i2 = -1
        for q = 0 to nb - 1
            float v = array.get(sm, q)
            if v >= hvnMin / 100.0 * mx and math.abs(q - pk) > w
                bool isPeak = true
                for r = math.max(0, q - w) to math.min(nb - 1, q + w)
                    float vr = array.get(sm, r)
                    if (r < q and vr >= v) or (r > q and vr > v)
                        isPeak := false
                if isPeak
                    if v > b1
                        b2 := b1
                        i2 := i1
                        b1 := v
                        i1 := q
                    else if v > b2
                        b2 := v
                        i2 := q
        if i1 >= 0
            h1 := priceOf(lo + i1, 0.5)
        if i2 >= 0 and hvnN >= 2
            h2 := priceOf(lo + i2, 0.5)
    [h1, h2]

// Valeurs a afficher (calculees sur la derniere barre uniquement).
// pend = la bougie en cours ouvre une nouvelle periode : le profil stocke devient "precedent".
vpDisplay(array<float> bins, array<int> m, float pPoc, float pVah, float pVal, int pSt, bool pend) =>
    float cPoc = na
    float cVah = na
    float cVal = na
    int cSt = bar_index
    float qPoc = pPoc
    float qVah = pVah
    float qVal = pVal
    int qSt = pSt
    if barstate.islast
        [s1, s2, s3] = vpStats(bins, m)
        int st = array.get(m, 2)
        if pend
            qPoc := s1
            qVah := s2
            qVal := s3
            qSt := st
        else
            cPoc := s1
            cVah := s2
            cVal := s3
            cSt := st
    [cPoc, cVah, cVal, cSt, qPoc, qVah, qVal, qSt]

// HVN a afficher : [courant 1, courant 2, precedent 1, precedent 2]
hvnDisplay(array<float> bins, array<int> m, float pH1, float pH2, bool pend) =>
    float c1 = na
    float c2 = na
    float q1 = pH1
    float q2 = pH2
    if barstate.islast
        [t1, t2] = vpHvn(bins, m)
        if pend
            q1 := t1
            q2 := t2
        else
            c1 := t1
            c2 := t2
    [c1, c2, q1, q2]

// Trace le POC (tirets) et, si full, VAH / VAL (pointilles), prolonges a droite
vpLevels(string nm, float poc, float vah, float val, int x1, bool show, color c, bool full) =>
    var line lp = na
    var line lh = na
    var line ll = na
    var label tp = na
    var label th = na
    var label tl = na
    if barstate.islast
        line.delete(lp)
        line.delete(lh)
        line.delete(ll)
        label.delete(tp)
        label.delete(th)
        label.delete(tl)
        if show and not na(poc)
            lp := line.new(x1, poc, bar_index, poc, extend = extend.right, color = c,
                 style = line.style_dashed, width = 1)
            if full
                lh := line.new(x1, vah, bar_index, vah, extend = extend.right, color = c,
                     style = line.style_dotted, width = 1)
                ll := line.new(x1, val, bar_index, val, extend = extend.right, color = c,
                     style = line.style_dotted, width = 1)
            if vpLbl
                string part = x1 == 0 ? " (partiel)" : ""
                tp := label.new(bar_index, poc, nm + "POC " + str.tostring(poc, "#.##") + part,
                     style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
                if full
                    th := label.new(bar_index, vah, nm + "VAH " + str.tostring(vah, "#.##"),
                         style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
                    tl := label.new(bar_index, val, nm + "VAL " + str.tostring(val, "#.##"),
                         style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
    true

// Trace les HVN (pointilles clairs), prolonges a droite
hvnLevels(string nm, float h1, float h2, int x1, bool show, color c) =>
    var line l1 = na
    var line l2 = na
    var label g1 = na
    var label g2 = na
    if barstate.islast
        line.delete(l1)
        line.delete(l2)
        label.delete(g1)
        label.delete(g2)
        if show and showHvn
            if not na(h1)
                l1 := line.new(x1, h1, bar_index, h1, extend = extend.right, color = color.new(c, 55),
                     style = line.style_dotted, width = 1)
                if vpLbl
                    g1 := label.new(bar_index, h1, nm + "HVN " + str.tostring(h1, "#.##"),
                         style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
            if not na(h2)
                l2 := line.new(x1, h2, bar_index, h2, extend = extend.right, color = color.new(c, 55),
                     style = line.style_dotted, width = 1)
                if vpLbl
                    g2 := label.new(bar_index, h2, nm + "HVN " + str.tostring(h2, "#.##"),
                         style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
    true

// ---------------- Confluences : fonctions ----------------
// Ajoute un niveau (prix, nom, source) a la liste si il est actif et defini
cfAdd(array<float> p, array<string> n, array<int> g, float price, string name, int grp, bool on) =>
    if on and not na(price)
        array.push(p, price)
        array.push(n, name)
        array.push(g, grp)
    true

// Ecrit une cellule du tableau
cfCell(int cc, int row, string t, color tc, bool left, color bg) =>
    table.cell(cf, cc, row, t, text_color = tc, text_halign = left ? text.align_left : text.align_right,
         text_size = size.small, bgcolor = bg)
    true

// Ecrit la ligne d'une zone : fleche (sens), niveaux presents, prix de la zone et distance.
// kind > 0 : zone au-dessus (haussier) | kind < 0 : zone en dessous (baissier) | 0 : prix dans la zone
cfZone(int row, array<float> zMid, array<string> zTxt, array<int> zCnt, int z, int kind) =>
    float zm = array.get(zMid, z)
    float pct = (zm / close - 1) * 100
    string fmt = zm >= 1000 ? "#" : "#.##"
    string arrow = kind > 0 ? "▲" : kind < 0 ? "▼" : "◆"
    color ac = kind > 0 ? color.lime : kind < 0 ? color.red : color.yellow
    int cnt = array.get(zCnt, z)
    string more = cnt > 4 ? " +" + str.tostring(cnt - 4) : ""
    string sg = pct > 0 ? "+" : ""
    string dist = kind == 0 ? " (dans la zone)" : " (" + sg + str.tostring(pct, "#.##") + "%)"
    cfCell(0, row, arrow, ac, true, cfBg)
    cfCell(1, row, array.get(zTxt, z) + more, color.white, true, cfBg)
    cfCell(2, row, str.tostring(zm, fmt) + dist, ac, false, cfBg)
    true

// Ligne vide
cfBlank(int row) =>
    cfCell(0, row, "", color.gray, true, cfBg)
    cfCell(1, row, "", color.gray, true, cfBg)
    cfCell(2, row, "", color.gray, false, cfBg)
    true

var int firstBarTime = time

// ---------------- VWAP principale (periode selon le TF) ----------------
int tfSec = timeframe.in_seconds(timeframe.period)
string autoTf = tfSec <= dayMax * 60 ? "D" : tfSec <= weekMax * 60 ? "W" : tfSec <= monthMax * 60 ? "M" : "12M"

string tfPick = switch refMode
    "Jour"    => "D"
    "Semaine" => "W"
    "Mois"    => "M"
    "Annee"   => "12M"
    => autoTf

bool newPeriod = timeframe.change(tfPick)
[vw, up1, dn1] = ta.vwap(src, newPeriod, k1)
float atr14 = ta.atr(14)

// Periodes affichees (VWAP calendrier, Volume Profile, Opens).
// Auto (Smart) : les 3 plus courtes periodes qui contiennent au moins minBars barres du graphique.
bool validD = 86400.0 / tfSec >= minBars
bool validW = 604800.0 / tfSec >= minBars
bool validM = 2592000.0 / tfSec >= minBars
bool validY = 31536000.0 / tfSec >= minBars
bool isAuto = refMode == "Auto (Smart)"
bool isAll  = refMode == "Tout"
bool selD = refMode == "Jour" or ((isAuto or isAll) and validD)
bool selW = refMode == "Semaine" or ((isAuto or isAll) and validW)
bool selM = refMode == "Mois" or ((isAuto or isAll) and validM)
bool selY = refMode == "Annee" or (isAll and validY) or (isAuto and validY and not validD)

// ---------------- VWAP calendrier ----------------
int dayId  = int(math.floor(time / 86400000))
int weekId = int(math.floor((dayId + 3) / 7))
bool nD = dayId != dayId[1]
bool nW = weekId != weekId[1]
bool nM = month != month[1]
bool nY = year != year[1]

float wV = curVwap(src, nW)
float mV = curVwap(src, nM)
float yV = curVwap(src, nY)
float dV = dateVwap(src, dT)

// pas de doublon avec la VWAP principale, pas de ligne sur une periode trop courte pour le TF
bool sW = onW and selW and tfPick != "W"
bool sM = onM and selM and tfPick != "M"
bool sY = onY and selY and tfPick != "12M"

// ---------------- Opens de periode ----------------
var float dOpen = na
var int dStart = 0
var float wOpen = na
var float mOpen = na
var float yOpen = na
var int wStart = 0
var int mStart = 0
var int yStart = 0
if nD
    dOpen := open
    dStart := bar_index
if nW
    wOpen := open
    wStart := bar_index
if nM
    mOpen := open
    mStart := bar_index
if nY
    yOpen := open
    yStart := bar_index

// ---------------- Volume Profile : calcul par periode ----------------
var array<float> binsD = array.new_float(nBins, 0.0)
var array<float> binsW = array.new_float(nBins, 0.0)
var array<float> binsM = array.new_float(nBins, 0.0)
var array<float> binsY = array.new_float(nBins, 0.0)
var array<int> metaD = array.from(nBins, -1, 0)
var array<int> metaW = array.from(nBins, -1, 0)
var array<int> metaM = array.from(nBins, -1, 0)
var array<int> metaY = array.from(nBins, -1, 0)
var float pPocD = na
var float pVahD = na
var float pValD = na
var float pH1D = na
var float pH2D = na
var int pStD = 0
var float pPocW = na
var float pVahW = na
var float pValW = na
var float pH1W = na
var float pH2W = na
var int pStW = 0
var float pPocM = na
var float pVahM = na
var float pValM = na
var float pH1M = na
var float pH2M = na
var int pStM = 0
var float pPocY = na
var float pVahY = na
var float pValY = na
var float pH1Y = na
var float pH2Y = na
var int pStY = 0

// Les profils ne sont mis a jour qu'a la cloture de chaque bougie
if barstate.isconfirmed
    if nD
        [d1, d2, d3] = vpStats(binsD, metaD)
        [dh1, dh2] = vpHvn(binsD, metaD)
        pPocD := d1
        pVahD := d2
        pValD := d3
        pH1D := dh1
        pH2D := dh2
        pStD := array.get(metaD, 2)
        vpReset(binsD, metaD, bar_index)
    vpAdd(binsD, metaD, low, high, nz(volume))
    if nW
        [w1, w2, w3] = vpStats(binsW, metaW)
        [wh1, wh2] = vpHvn(binsW, metaW)
        pPocW := w1
        pVahW := w2
        pValW := w3
        pH1W := wh1
        pH2W := wh2
        pStW := array.get(metaW, 2)
        vpReset(binsW, metaW, bar_index)
    vpAdd(binsW, metaW, low, high, nz(volume))
    if nM
        [m1, m2, m3] = vpStats(binsM, metaM)
        [mh1, mh2] = vpHvn(binsM, metaM)
        pPocM := m1
        pVahM := m2
        pValM := m3
        pH1M := mh1
        pH2M := mh2
        pStM := array.get(metaM, 2)
        vpReset(binsM, metaM, bar_index)
    vpAdd(binsM, metaM, low, high, nz(volume))
    if nY
        [y1, y2, y3] = vpStats(binsY, metaY)
        [yh1, yh2] = vpHvn(binsY, metaY)
        pPocY := y1
        pVahY := y2
        pValY := y3
        pH1Y := yh1
        pH2Y := yh2
        pStY := array.get(metaY, 2)
        vpReset(binsY, metaY, bar_index)
    vpAdd(binsY, metaY, low, high, nz(volume))

bool livePend = not barstate.isconfirmed
[cPocD, cVahD, cValD, cStD, qPocD, qVahD, qValD, qStD] = vpDisplay(binsD, metaD,
     pPocD, pVahD, pValD, pStD, livePend and nD)
[cPocW, cVahW, cValW, cStW, qPocW, qVahW, qValW, qStW] = vpDisplay(binsW, metaW,
     pPocW, pVahW, pValW, pStW, livePend and nW)
[cPocM, cVahM, cValM, cStM, qPocM, qVahM, qValM, qStM] = vpDisplay(binsM, metaM,
     pPocM, pVahM, pValM, pStM, livePend and nM)
[cPocY, cVahY, cValY, cStY, qPocY, qVahY, qValY, qStY] = vpDisplay(binsY, metaY,
     pPocY, pVahY, pValY, pStY, livePend and nY)
[cH1D, cH2D, qH1D, qH2D] = hvnDisplay(binsD, metaD, pH1D, pH2D, livePend and nD)
[cH1W, cH2W, qH1W, qH2W] = hvnDisplay(binsW, metaW, pH1W, pH2W, livePend and nW)
[cH1M, cH2M, qH1M, qH2M] = hvnDisplay(binsM, metaM, pH1M, pH2M, livePend and nM)
[cH1Y, cH2Y, qH1Y, qH2Y] = hvnDisplay(binsY, metaY, pH1Y, pH2Y, livePend and nY)

// ---------------- Trace : VWAP ----------------
bool bands = showBnd and not newPeriod
plot(newPeriod ? na : vw, "VWAP", color = col, linewidth = 2, style = plot.style_linebr)
plot(bands ? up1 : na, "Bande +1", color = color.new(col, 60), style = plot.style_linebr,
     display = display.pane)
plot(bands ? dn1 : na, "Bande -1", color = color.new(col, 60), style = plot.style_linebr,
     display = display.pane)
plot(sW and not nW ? wV : na, "Weekly", color = cW, linewidth = 1, style = plot.style_linebr,
     display = display.pane)
plot(sM and not nM ? mV : na, "cMonth", color = cM, linewidth = 1, style = plot.style_linebr,
     display = display.pane)
plot(sY and not nY ? yV : na, "Yearly", color = cY, linewidth = 1, style = plot.style_linebr,
     display = display.pane)
plot(onD ? dV : na, "VWAP date", color = cD, linewidth = 1, style = plot.style_linebr,
     display = display.pane)

// ---------------- Etiquettes VWAP ----------------
tag("Weekly", wV, cW, sW)
tag("cMonth", mV, cM, sM)
tag("Yearly", yV, cY, sY)
tag(dNm + (dT < firstBarTime ? " (historique insuffisant)" : ""), dV, cD, onD)

// ---------------- Lignes Volume Profile ----------------
bool vD = onVD and selD
bool vW = onVW and selW
bool vM = onVM and selM
bool vY = onVY and selY
vpLevels("d", cPocD, cVahD, cValD, cStD, vD, cVD, false)
vpLevels("pd", qPocD, qVahD, qValD, qStD, vD, color.new(cVD, 40), true)
vpLevels("w", cPocW, cVahW, cValW, cStW, vW, cVW, false)
vpLevels("pw", qPocW, qVahW, qValW, qStW, vW, color.new(cVW, 40), true)
vpLevels("m", cPocM, cVahM, cValM, cStM, vM, cVM, false)
vpLevels("pm", qPocM, qVahM, qValM, qStM, vM, color.new(cVM, 40), true)
vpLevels("y", cPocY, cVahY, cValY, cStY, vY, cVY, false)
vpLevels("py", qPocY, qVahY, qValY, qStY, vY, color.new(cVY, 40), true)
hvnLevels("d", cH1D, cH2D, cStD, vD, cVD)
hvnLevels("pd", qH1D, qH2D, qStD, vD, color.new(cVD, 40))
hvnLevels("w", cH1W, cH2W, cStW, vW, cVW)
hvnLevels("pw", qH1W, qH2W, qStW, vW, color.new(cVW, 40))
hvnLevels("m", cH1M, cH2M, cStM, vM, cVM)
hvnLevels("pm", qH1M, qH2M, qStM, vM, color.new(cVM, 40))
hvnLevels("y", cH1Y, cH2Y, cStY, vY, cVY)
hvnLevels("py", qH1Y, qH2Y, qStY, vY, color.new(cVY, 40))

// ---------------- Lignes d'open ----------------
bool sOD = onOD and selD
bool sOW = onOW and selW
bool sOM = onOM and selM
bool sOY = onOY and selY
openLine("dOpen", dOpen, dStart, sOD, cOD)
openLine("wOpen", wOpen, wStart, sOW, cOW)
openLine("mOpen", mOpen, mStart, sOM, cOM)
openLine("yOpen", yOpen, yStart, sOY, cOY)

// ---------------- Tableau des confluences ----------------
var array<float> cfP = array.new_float()
var array<string> cfN = array.new_string()
var array<int> cfG = array.new_int()

if barstate.islast and showTbl
    // 1) liste des niveaux actifs (nom, prix, source : un profil = une seule source)
    array.clear(cfP)
    array.clear(cfN)
    array.clear(cfG)
    cfAdd(cfP, cfN, cfG, vw, "VWAP", 1, true)
    cfAdd(cfP, cfN, cfG, wV, "wVWAP", 2, sW)
    cfAdd(cfP, cfN, cfG, mV, "mVWAP", 3, sM)
    cfAdd(cfP, cfN, cfG, yV, "yVWAP", 4, sY)
    cfAdd(cfP, cfN, cfG, dV, dNm, 5, onD)
    cfAdd(cfP, cfN, cfG, dOpen, "dOpen", 17, sOD)
    cfAdd(cfP, cfN, cfG, wOpen, "wOpen", 6, sOW)
    cfAdd(cfP, cfN, cfG, mOpen, "mOpen", 7, sOM)
    cfAdd(cfP, cfN, cfG, yOpen, "yOpen", 8, sOY)
    cfAdd(cfP, cfN, cfG, cPocD, "dPOC", 15, vD)
    cfAdd(cfP, cfN, cfG, cH1D, "dHVN", 15, vD)
    cfAdd(cfP, cfN, cfG, cH2D, "dHVN", 15, vD)
    cfAdd(cfP, cfN, cfG, qPocD, "pdPOC", 16, vD)
    cfAdd(cfP, cfN, cfG, qVahD, "pdVAH", 16, vD)
    cfAdd(cfP, cfN, cfG, qValD, "pdVAL", 16, vD)
    cfAdd(cfP, cfN, cfG, qH1D, "pdHVN", 16, vD)
    cfAdd(cfP, cfN, cfG, qH2D, "pdHVN", 16, vD)
    cfAdd(cfP, cfN, cfG, cPocW, "wPOC", 9, vW)
    cfAdd(cfP, cfN, cfG, cH1W, "wHVN", 9, vW)
    cfAdd(cfP, cfN, cfG, cH2W, "wHVN", 9, vW)
    cfAdd(cfP, cfN, cfG, qPocW, "pwPOC", 10, vW)
    cfAdd(cfP, cfN, cfG, qVahW, "pwVAH", 10, vW)
    cfAdd(cfP, cfN, cfG, qValW, "pwVAL", 10, vW)
    cfAdd(cfP, cfN, cfG, qH1W, "pwHVN", 10, vW)
    cfAdd(cfP, cfN, cfG, qH2W, "pwHVN", 10, vW)
    cfAdd(cfP, cfN, cfG, cPocM, "mPOC", 11, vM)
    cfAdd(cfP, cfN, cfG, cH1M, "mHVN", 11, vM)
    cfAdd(cfP, cfN, cfG, cH2M, "mHVN", 11, vM)
    cfAdd(cfP, cfN, cfG, qPocM, "pmPOC", 12, vM)
    cfAdd(cfP, cfN, cfG, qVahM, "pmVAH", 12, vM)
    cfAdd(cfP, cfN, cfG, qValM, "pmVAL", 12, vM)
    cfAdd(cfP, cfN, cfG, qH1M, "pmHVN", 12, vM)
    cfAdd(cfP, cfN, cfG, qH2M, "pmHVN", 12, vM)
    cfAdd(cfP, cfN, cfG, cPocY, "yPOC", 13, vY)
    cfAdd(cfP, cfN, cfG, cH1Y, "yHVN", 13, vY)
    cfAdd(cfP, cfN, cfG, cH2Y, "yHVN", 13, vY)
    cfAdd(cfP, cfN, cfG, qPocY, "pyPOC", 14, vY)
    cfAdd(cfP, cfN, cfG, qVahY, "pyVAH", 14, vY)
    cfAdd(cfP, cfN, cfG, qValY, "pyVAL", 14, vY)
    cfAdd(cfP, cfN, cfG, qH1Y, "pyHVN", 14, vY)
    cfAdd(cfP, cfN, cfG, qH2Y, "pyHVN", 14, vY)

    // 2) zones : niveaux tries par prix, regroupes dans une fenetre <= tolerance,
    //    gardees si elles contiennent au moins 2 sources differentes
    int n = array.size(cfP)
    array<int> ord = array.sort_indices(cfP)
    float tol = math.max(confAtr * atr14, confMin / 100.0 * close)
    array<float> zMid = array.new_float()
    array<float> zLo = array.new_float()
    array<float> zHi = array.new_float()
    array<string> zTxt = array.new_string()
    array<int> zCnt = array.new_int()
    int i = 0
    while i < n
        float b0 = array.get(cfP, array.get(ord, i))
        int j = i
        bool go = true
        while go
            if j + 1 < n
                if array.get(cfP, array.get(ord, j + 1)) - b0 <= tol
                    j += 1
                else
                    go := false
            else
                go := false
        if j > i
            array<int> seen = array.new_int()
            string zt = ""
            float zs = 0.0
            for k = i to j
                int idx = array.get(ord, k)
                int g = array.get(cfG, idx)
                if not array.includes(seen, g)
                    array.push(seen, g)
                zs += array.get(cfP, idx)
                if k - i < 4
                    zt := zt + (k > i ? " + " : "") + array.get(cfN, idx)
            if array.size(seen) >= 2
                array.push(zMid, zs / (j - i + 1))
                array.push(zLo, array.get(cfP, array.get(ord, i)))
                array.push(zHi, array.get(cfP, array.get(ord, j)))
                array.push(zTxt, zt)
                array.push(zCnt, j - i + 1)
        i := j + 1

    // 3) on garde les 2 zones les plus proches au-dessus, celle ou l'on est, les 2 plus proches en dessous
    int nzn = array.size(zMid)
    array<float> zd = array.new_float()
    int q = 0
    while q < nzn
        float qlo = array.get(zLo, q)
        float qhi = array.get(zHi, q)
        bool qin = close >= qlo and close <= qhi
        array.push(zd, qin ? 0.0 : math.min(math.abs(qlo - close), math.abs(qhi - close)))
        q += 1
    array<int> zo = array.sort_indices(zd)
    array<int> selA = array.new_int()
    array<int> selB = array.new_int()
    int selI = -1
    int t = 0
    while t < nzn
        int z = array.get(zo, t)
        if array.get(zLo, z) > close
            if array.size(selA) < 2
                array.push(selA, z)
        else if array.get(zHi, z) < close
            if array.size(selB) < 2
                array.push(selB, z)
        else
            selI := z
        t += 1

    // 4) tableau en echelle : zones au-dessus (haute en haut), zone actuelle, prix, zones en dessous
    cfCell(0, 0, "Sens", color.gray, true, cfBg)
    cfCell(1, 0, "Confluences", color.gray, true, cfBg)
    cfCell(2, 0, "Zone", color.gray, false, cfBg)
    int rr = 1
    if nzn == 0
        cfCell(0, rr, "", color.gray, true, cfBg)
        cfCell(1, rr, "Aucune confluence", color.gray, true, cfBg)
        cfCell(2, rr, "", color.gray, false, cfBg)
        rr += 1
    int ui = array.size(selA) - 1
    while ui >= 0
        cfZone(rr, zMid, zTxt, zCnt, array.get(selA, ui), 1)
        rr += 1
        ui -= 1
    if selI >= 0
        cfZone(rr, zMid, zTxt, zCnt, selI, 0)
        rr += 1
    cfCell(0, rr, "", color.gray, true, cfPriceBg)
    cfCell(1, rr, "PRIX", color.silver, true, cfPriceBg)
    cfCell(2, rr, str.tostring(close, close >= 1000 ? "#" : "#.##"), color.white, false, cfPriceBg)
    rr += 1
    int di = 0
    while di < array.size(selB)
        cfZone(rr, zMid, zTxt, zCnt, array.get(selB, di), -1)
        rr += 1
        di += 1
    while rr <= 6
        cfBlank(rr)
        rr += 1

// Etiquette de la VWAP principale (periode utilisee)
var label info = na
if barstate.islast
    label.delete(info)
    bool tooBig = timeframe.in_seconds(tfPick) <= tfSec
    string txt = "VWAP " + periodName(tfPick) + (tooBig ? " (TF trop grand)" : "")
    info := label.new(bar_index, nz(vw, close), txt, style = label.style_label_left,
         color = color.new(color.black, 100), textcolor = col)
