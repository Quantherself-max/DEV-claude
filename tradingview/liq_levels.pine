//@version=6
indicator("Liquidation Levels (estime)", "LiqLevels", overlay = true, max_boxes_count = 500,
     max_labels_count = 60)

// Poches de liquidation ESTIMEES, affichees en barres horizontales ancrees sur la bougie actuelle :
// plus la poche est grosse, plus la barre est longue et opaque (degrade qui s'estompe vers la gauche).
// Rouge = shorts (au-dessus du prix), vert = longs (sous le prix). Seules les poches assez fortes et
// assez proches pour compter sont gardees.
// DONNEES (proxy, pas de vraies liquidations) : l'Open Interest Binance USDT perp fourni par
// TradingView (request.security sur <coin>USDT.P_OI) + prix / volume du meme perp. Chaque hausse d'OI
// = nouvelles positions, ouvertes au prix de la sous-bougie. Hypotheses (reglables) : repartition
// longs / shorts selon la direction de la bougie, puis leviers 100x / 50x / 25x / 10x ; le prix de
// liquidation de chaque groupe vient de la formule isolee avec marge de maintenance. Un niveau
// disparait quand le prix le touche ; quand l'OI baisse, les niveaux restants sont reduits d'autant.
// Filtre : fenetre autour du prix en ATR du graphique, seuil en % de la plus grosse poche, nombre
// maximum de poches par cote. L'historique est en jours (pas en barres) : meme lecture a tous les TF.
// "Aimant" = hypothese de lecture (une grosse poche attire le prix), non validee statistiquement.

G1 = "Donnees"
modeIn   = input.string("Open Interest", "Source de la taille", group = G1,
     options = ["Open Interest", "Volume"])
oiCustom = input.string("", "Symbole OI (vide = BINANCE:<coin>USDT.P_OI)", group = G1)
ltfIn    = input.string("Auto", "Precision : donnees fines (timeframe en minutes)", group = G1,
     options = ["Auto", "Aucun (graphique)", "1", "5", "15", "30", "60", "240"])
lookDays = input.int(60, "Historique pris en compte (jours)", minval = 5, maxval = 365, group = G1)

G2 = "Leviers et marge (poids = part estimee des positions)"
lev1 = input.int(100, "Levier haut 1", minval = 2, maxval = 200, inline = "l1", group = G2)
wt1  = input.float(10.0, "poids", minval = 0.0, inline = "l1", group = G2)
lev2 = input.int(50, "Levier haut 2", minval = 2, maxval = 200, inline = "l2", group = G2)
wt2  = input.float(20.0, "poids", minval = 0.0, inline = "l2", group = G2)
lev3 = input.int(25, "Levier moyen 1", minval = 2, maxval = 200, inline = "l3", group = G2)
wt3  = input.float(30.0, "poids", minval = 0.0, inline = "l3", group = G2)
lev4 = input.int(10, "Levier moyen 2", minval = 2, maxval = 200, inline = "l4", group = G2)
wt4  = input.float(40.0, "poids", minval = 0.0, inline = "l4", group = G2)
mmrIn = input.float(0.4, "Marge de maintenance (%) - BTC Binance palier 1 : 0.4", minval = 0.0,
     maxval = 5.0, step = 0.05, group = G2)
splitMode = input.string("Direction de la bougie", "Repartition longs / shorts", group = G2,
     options = ["Direction de la bougie", "50 / 50"])
shrink = input.bool(true, "Reduire les niveaux quand l'OI baisse", group = G2)

G3 = "Filtre : seulement les liquidites qui comptent"
distAtr   = input.float(8.0, "Fenetre autour du prix (x ATR du graphique)", minval = 1.0, step = 0.5,
     group = G3)
minDist   = input.float(1.5, "Fenetre minimale (% du prix)", minval = 0.2, step = 0.1, group = G3)
keepPct   = input.float(35.0, "Garder les poches >= X % de la plus grosse", minval = 5.0, maxval = 100.0,
     step = 5.0, group = G3)
perSide   = input.int(3, "Poches max par cote", minval = 1, maxval = 8, group = G3)
clustPct  = input.float(0.25, "Regrouper les niveaux a moins de X % l'un de l'autre", minval = 0.05,
     maxval = 2.0, step = 0.05, group = G3)
magnetPct = input.float(70.0, "AIMANT : la plus forte par cote, si >= X %", minval = 10.0,
     maxval = 100.0, step = 5.0, group = G3)

G4 = "Affichage"
styleIn  = input.string("Degrade", "Style des barres", group = G4, options = ["Degrade", "Plat"])
showL    = input.bool(true, "Longs (sous le prix)", inline = "sl", group = G4)
colL     = input.color(#3DDC97, "", inline = "sl", group = G4)
showS    = input.bool(true, "Shorts (au-dessus du prix)", inline = "ss", group = G4)
colS     = input.color(#FF6B6B, "", inline = "ss", group = G4)
lenMode  = input.string("Auto (% de l'ecran)", "Longueur des barres", group = G4,
     options = ["Auto (% de l'ecran)", "Fixe (barres)"])
lenPct   = input.float(28.0, "Auto : longueur max (% de l'ecran)", minval = 5.0, maxval = 80.0,
     step = 1.0, group = G4)
maxLen   = input.int(60, "Fixe : longueur max (barres)", minval = 10, maxval = 600, group = G4)
thkAtr   = input.float(0.15, "Epaisseur minimale (x ATR)", minval = 0.02, maxval = 1.0, step = 0.01,
     group = G4)
lblN     = input.int(2, "Etiquettes : poches par cote (0 = aucune)", minval = 0, maxval = 8, group = G4)
showTbl  = input.bool(true, "Afficher le tableau de bord", group = G4)
tblPosIn = input.string("Milieu droite", "Position du tableau", group = G4,
     options = ["Haut droite", "Milieu droite", "Bas droite", "Haut gauche", "Bas gauche"])

// Grille de prix : bins logarithmiques de 0.05 % (de mintick a mintick x 1e9)
float lnStep = math.log(1.0 + 0.05 / 100.0)
float minPx  = syminfo.mintick
int lnBase   = int(math.floor(math.log(minPx) / lnStep))
int nBins    = int(math.ceil(math.log(1000000000.0) / lnStep)) + 2
float mmr    = mmrIn / 100.0
float wSum   = math.max(wt1 + wt2 + wt3 + wt4, 0.0001)
bool useOi   = modeIn == "Open Interest"
float atr14  = ta.atr(14)

// Open Interest du coin sur Binance (USDT perp), ou symbole choisi ; prix du meme perp
string oiSym   = oiCustom != "" ? oiCustom : "BINANCE:" + syminfo.basecurrency + "USDT.P_OI"
string perpSym = str.replace_all(oiSym, "_OI", "")

// Donnees fines : timeframe plus petit que le graphique (Auto : 3 a 42 sous-bougies par bougie)
int tfSec = timeframe.in_seconds(timeframe.period)
string ltfAuto = tfSec <= 300 ? "" : tfSec <= 3600 ? "5" : tfSec <= 14400 ? "15" :
     tfSec <= 86400 ? "60" : "240"
string ltfSel  = ltfIn == "Auto" ? ltfAuto : ltfIn == "Aucun (graphique)" ? "" : ltfIn
bool ltfOn     = ltfSel != "" and timeframe.in_seconds(ltfSel) < tfSec
string ltfReq  = ltfOn ? ltfSel : timeframe.period
int lookBars   = math.min(20000, int(math.ceil(lookDays * 86400.0 / tfSec)))

float oi = request.security(oiSym, timeframe.period, close, ignore_invalid_symbol = true)
[oiA, oiT] = request.security_lower_tf(oiSym, ltfReq, [close, time], ignore_invalid_symbol = true,
     ignore_invalid_timeframe = true)
[pH, pL, pC, pV, pT] = request.security_lower_tf(perpSym, ltfReq, [high, low, close, volume, time],
     ignore_invalid_symbol = true, ignore_invalid_timeframe = true)

string tblPos = switch tblPosIn
    "Haut droite"   => position.top_right
    "Bas droite"    => position.bottom_right
    "Haut gauche"   => position.top_left
    "Bas gauche"    => position.bottom_left
    => position.middle_right

// Etat. Les tailles sont stockees "brutes" ; taille reelle = brute x sc[1] (reduction globale de l'OI).
// sc = [dernier OI, echelle globale, pas fins traites, pas graphique traites, pas avec OI]
var array<float> lSz = array.new_float(nBins, 0.0)
var array<int> lAct = array.new_int()
var array<float> sSz = array.new_float(nBins, 0.0)
var array<int> sAct = array.new_int()
var array<float> sc = array.from(float(na), 1.0, 0.0, 0.0, 0.0)
var array<float> levA = array.from(float(lev1), float(lev2), float(lev3), float(lev4))
var array<float> wA = array.from(wt1, wt2, wt3, wt4)
var array<float> gpP = array.new_float()
var array<float> gpZ = array.new_float()
var array<float> gpLo = array.new_float()
var array<float> gpHi = array.new_float()
var array<int> gpD = array.new_int()
var array<box> boxes = array.new_box()
var array<label> lbls = array.new_label()
var table dash = table.new(tblPos, 2, 5, border_width = 0)

idxOf(float p) =>
    int i = int(math.floor(math.log(math.max(p, minPx)) / lnStep)) - lnBase
    math.max(0, math.min(nBins - 1, i))

priceOf(int i, float off) =>
    math.exp((i + lnBase + off) * lnStep)

// Position d'insertion dans un tableau d'entiers trie (premier element >= v)
lowerBound(array<int> a, int v) =>
    int lo = 0
    int hi = array.size(a)
    while lo < hi
        int mid = int(math.floor((lo + hi) / 2.0))
        if array.get(a, mid) < v
            lo := mid + 1
        else
            hi := mid
    lo

// Ajoute une taille a un bin de prix (les bins actifs restent tries par prix croissant)
addLvl(array<float> sz, array<int> act, float price, float amt) =>
    int i = idxOf(price)
    if array.get(sz, i) <= 0.0
        array.insert(act, lowerBound(act, i), i)
    array.set(sz, i, array.get(sz, i) + amt / array.get(sc, 1))
    true

// Longs liquides : tous les niveaux actifs a un prix >= low (les plus hauts sont en fin de tableau)
sweepL(float l) =>
    int hit = 0
    bool go = true
    while go and array.size(lAct) > 0
        int i = array.get(lAct, array.size(lAct) - 1)
        if priceOf(i, 0.5) >= l
            array.set(lSz, i, 0.0)
            array.pop(lAct)
            hit += 1
        else
            go := false
    hit

// Shorts liquides : tous les niveaux actifs a un prix <= high (les plus bas sont en debut de tableau)
sweepS(float h) =>
    int hit = 0
    bool go = true
    while go and array.size(sAct) > 0
        int i = array.get(sAct, 0)
        if priceOf(i, 0.5) <= h
            array.set(sSz, i, 0.0)
            array.shift(sAct)
            hit += 1
        else
            go := false
    hit

// Positions fermees : echelle globale reduite (renormalisee si elle devient trop petite)
scaleDown(float f) =>
    float g = array.get(sc, 1) * f
    if g < 0.000001
        int k = 0
        while k < array.size(lAct)
            int i = array.get(lAct, k)
            array.set(lSz, i, array.get(lSz, i) * g)
            k += 1
        k := 0
        while k < array.size(sAct)
            int j = array.get(sAct, k)
            array.set(sSz, j, array.get(sSz, j) * g)
            k += 1
        g := 1.0
    array.set(sc, 1, g)
    true

// Un pas de temps (sous-bougie ou bougie) : le prix touche des niveaux, l'OI change, des niveaux naissent
stepLvl(float oiNow, float h, float l, float c, float vol) =>
    if not (na(h) or na(l) or na(c))
        int hits = sweepL(l) + sweepS(h)
        float oiLast = array.get(sc, 0)
        float d = (na(oiNow) or na(oiLast)) ? 0.0 : oiNow - oiLast
        if useOi and not na(oiNow)
            array.set(sc, 0, oiNow)
            array.set(sc, 4, array.get(sc, 4) + 1.0)
        if useOi and shrink and hits == 0 and d < 0 and oiLast > 0
            scaleDown(oiNow / oiLast)
        float amt = useOi ? math.max(d, 0.0) : vol
        if amt > 0
            float px = (h + l + c) / 3.0
            float rng = h - l
            float clv = rng > 0 ? ((c - l) - (h - c)) / rng : 0.0
            float lSh = splitMode == "50 / 50" ? 0.5 : math.max(0.2, math.min(0.8, 0.5 + 0.5 * clv))
            for q = 0 to 3
                float lev = array.get(levA, q)
                float wq = array.get(wA, q) / wSum
                if lev > 1.0 and wq > 0
                    float pl = px * (1.0 - 1.0 / lev + mmr)
                    float ps = px * (1.0 + 1.0 / lev - mmr)
                    if pl < l
                        addLvl(lSz, lAct, pl, amt * lSh * wq)
                    if ps > h
                        addLvl(sSz, sAct, ps, amt * (1.0 - lSh) * wq)
    true

// Poches : niveaux actifs voisins (a moins de clustPct % l'un de l'autre) additionnes,
// uniquement dans la fenetre autour du prix. Chaque poche : prix moyen pondere, taille, bornes, cote.
buildPools(array<float> sz, array<int> act, int side, float winAbs) =>
    float g = array.get(sc, 1)
    float tol = clustPct / 100.0
    float cs = 0.0
    float cw = 0.0
    float cBase = 0.0
    float cLo = 0.0
    float cHi = 0.0
    int n = array.size(act)
    for k = 0 to n
        int i = 0
        float p = 0.0
        float s = 0.0
        bool elig = false
        if k < n
            i := array.get(act, k)
            p := priceOf(i, 0.5)
            s := array.get(sz, i) * g
            elig := math.abs(p - close) <= winAbs
        bool fin = k == n
        if cs > 0 and (fin or (elig and p > cBase * (1.0 + tol)))
            array.push(gpP, cw / cs)
            array.push(gpZ, cs)
            array.push(gpLo, cLo)
            array.push(gpHi, cHi)
            array.push(gpD, side)
            cs := 0.0
            cw := 0.0
        if elig
            if cs == 0.0
                cBase := p
                cLo := priceOf(i, 0.0)
            cHi := priceOf(i, 1.0)
            cs += s
            cw += s * p
    true

// ---------------- Mise a jour a la cloture de chaque barre ----------------
bool inWin = bar_index > last_bar_index - lookBars
if barstate.isconfirmed and inWin
    int nP = 0
    int nO = 0
    if not na(pT)
        nP := array.size(pT)
    if not na(oiT)
        nO := array.size(oiT)
    if ltfOn and nP > 0 and (nO > 0 or not useOi)
        for k = 0 to nP - 1
            int tk = array.get(pT, k)
            float oiK = na
            if useOi and nO > 0
                int j = -1
                if k < nO
                    if array.get(oiT, k) == tk
                        j := k
                if j < 0
                    j := array.indexof(oiT, tk)
                if j >= 0
                    oiK := array.get(oiA, j)
            stepLvl(oiK, array.get(pH, k), array.get(pL, k), array.get(pC, k), nz(array.get(pV, k)))
        array.set(sc, 2, array.get(sc, 2) + 1.0)
    else
        stepLvl(useOi ? oi : na, high, low, close, nz(volume))
        array.set(sc, 3, array.get(sc, 3) + 1.0)

// ---------------- Trace (derniere barre) ----------------
if barstate.islast
    int db = array.size(boxes) - 1
    while db >= 0
        box.delete(array.get(boxes, db))
        db -= 1
    array.clear(boxes)
    int dl = array.size(lbls) - 1
    while dl >= 0
        label.delete(array.get(lbls, dl))
        dl -= 1
    array.clear(lbls)

    // 1) poches dans la fenetre autour du prix (ATR du graphique, avec un minimum en %)
    float winAbs = math.max(distAtr * atr14, minDist / 100.0 * close)
    array.clear(gpP)
    array.clear(gpZ)
    array.clear(gpLo)
    array.clear(gpHi)
    array.clear(gpD)
    if showL
        buildPools(lSz, lAct, 1, winAbs)
    if showS
        buildPools(sSz, sAct, -1, winAbs)
    int nPool = array.size(gpZ)
    float maxPool = nPool > 0 ? array.max(gpZ) : 0.0

    // longueur maximale d'une barre : part de l'ecran visible (ou valeur fixe)
    float visSec = (chart.right_visible_bar_time - chart.left_visible_bar_time) / 1000.0
    int visBars = int(math.round(visSec / tfSec))
    bool useFix = lenMode == "Fixe (barres)" or visBars < 20
    int maxL = useFix ? maxLen : int(math.round(visBars * lenPct / 100.0))
    maxL := math.max(10, math.min(600, maxL))

    // 2) on ne garde que les plus grosses (>= keepPct de la plus grosse, perSide max par cote)
    float sumUp = 0.0
    float sumDn = 0.0
    int keptL = 0
    int keptS = 0
    float nearD = 1.0e12
    string nearTxt = "-"
    string topTxt = "Aucune poche assez forte"
    if maxPool > 0
        array<int> po = array.sort_indices(gpZ, order.descending)
        for u = 0 to nPool - 1
            int q = array.get(po, u)
            float z = array.get(gpZ, q)
            float pw = array.get(gpP, q)
            int pd = array.get(gpD, q)
            float rel = z / maxPool
            if pd > 0
                sumDn += z
            else
                sumUp += z
            bool okRel = rel >= keepPct / 100.0
            bool okCnt = pd > 0 ? keptL < perSide : keptS < perSide
            if okRel and okCnt
                if pd > 0
                    keptL += 1
                else
                    keptS += 1
                bool top1 = (pd > 0 and keptL == 1) or (pd < 0 and keptS == 1)
                bool mag = top1 and rel >= magnetPct / 100.0
                float dpct = (pw / close - 1.0) * 100.0
                string sg = dpct > 0 ? "+" : ""
                string ptxt = str.tostring(pw, format.mintick) + "  " + sg + str.tostring(dpct, "0.0") + "%"
                string arrow = pd > 0 ? "▼ " : "▲ "
                int score = int(math.round(rel * 100.0))
                float dAbs = math.abs(pw - close)
                if dAbs < nearD
                    nearD := dAbs
                    nearTxt := arrow + ptxt + "  (" + str.tostring(dAbs / math.max(atr14, minPx), "0.0")
                         + " ATR)"
                if keptL + keptS == 1
                    topTxt := arrow + (mag ? "AIMANT " : "") + ptxt + "  [" + str.tostring(score) + "]"

                // epaisseur : l'etendue de la poche, au moins thkAtr x ATR ; halo plus large et tres leger
                float bLo = array.get(gpLo, q)
                float bHi = array.get(gpHi, q)
                float minCore = math.max(thkAtr * atr14, 0.0003 * pw)
                if bHi - bLo < minCore
                    bLo := pw - minCore / 2.0
                    bHi := pw + minCore / 2.0
                float mid = (bLo + bHi) / 2.0
                float haloH = (bHi - bLo) / 2.0 * 1.8

                // barre : ancree sur la bougie actuelle ; longueur et opacite selon la taille
                int blen = math.max(6, int(math.round(maxL * math.pow(rel, 0.7))))
                float amax = math.min(0.9, 0.22 + 0.55 * math.pow(rel, 0.8) + (mag ? 0.1 : 0.0))
                bool fade = styleIn == "Degrade"
                int nSeg = fade ? math.min(12, blen) : 1
                color pc = pd > 0 ? colL : colS
                for sg2 = 0 to nSeg - 1
                    int xR = bar_index - int(math.round(blen * sg2 / nSeg))
                    int xL = math.max(0, bar_index - int(math.round(blen * (sg2 + 1) / nSeg)))
                    float f = fade ? math.pow(1.0 - sg2 / float(nSeg), 1.8) : 1.0
                    if xR > xL
                        if fade
                            int trH = int(math.round(100.0 - 100.0 * math.min(0.9, 0.16 * amax * f)))
                            array.push(boxes, box.new(xL, mid + haloH, xR, mid - haloH,
                                 border_color = color.new(pc, 100), bgcolor = color.new(pc, trH)))
                        int trC = int(math.round(100.0 - 100.0 * math.min(0.9, amax * f)))
                        array.push(boxes, box.new(xL, bHi, xR, bLo, border_color = color.new(pc, 100),
                             bgcolor = color.new(pc, trC)))

                // etiquette en pastille a droite de la barre (les plus grosses de chaque cote)
                int rk = pd > 0 ? keptL : keptS
                if rk <= lblN
                    string lt = (mag ? "AIMANT  " : "") + ptxt
                    array.push(lbls, label.new(bar_index + 1, pw, lt, style = label.style_label_left,
                         color = color.new(pc, mag ? 10 : 45), textcolor = mag ? color.black : color.white,
                         size = size.small))

    // 3) tableau de bord sobre
    if showTbl
        float nIn = array.get(sc, 2)
        float nCh = array.get(sc, 3)
        string precTxt = nIn > nCh ? ltfSel + " min" : "graphique"
        string oiOk = array.get(sc, 4) > 0 ? "PROXY OI Binance" : "OI INDISPONIBLE"
        string srcTxt = useOi ? oiOk : "PROXY Volume"
        float tot = sumUp + sumDn
        string upP = str.tostring(sumUp / math.max(tot, 0.0000001) * 100.0, "0")
        string dnP = str.tostring(sumDn / math.max(tot, 0.0000001) * 100.0, "0")
        string imbTxt = tot > 0 ? "▲ " + upP + "%  |  ▼ " + dnP + "%" : "-"
        string keepTxt = str.tostring(keptL + keptS) + " / " + str.tostring(nPool) + " poches"
        color bgc = color.new(#131722, 25)
        color bgh = color.new(color.gray, 70)
        table.cell(dash, 0, 0, "LiqLevels", text_color = color.white, text_size = size.small,
             text_halign = text.align_left, bgcolor = bgh)
        table.cell(dash, 1, 0, keepTxt, text_color = color.silver, text_size = size.small,
             text_halign = text.align_right, bgcolor = bgh)
        table.cell(dash, 0, 1, "Donnees", text_color = color.gray, text_size = size.small,
             text_halign = text.align_left, bgcolor = bgc)
        table.cell(dash, 1, 1, srcTxt + " | " + precTxt, text_color = color.white, text_size = size.small,
             text_halign = text.align_right, bgcolor = bgc)
        table.cell(dash, 0, 2, "Plus proche", text_color = color.gray, text_size = size.small,
             text_halign = text.align_left, bgcolor = bgc)
        table.cell(dash, 1, 2, nearTxt, text_color = color.white, text_size = size.small,
             text_halign = text.align_right, bgcolor = bgc)
        table.cell(dash, 0, 3, "Plus forte", text_color = color.gray, text_size = size.small,
             text_halign = text.align_left, bgcolor = bgc)
        table.cell(dash, 1, 3, topTxt, text_color = color.white, text_size = size.small,
             text_halign = text.align_right, bgcolor = bgc)
        table.cell(dash, 0, 4, "Desequilibre", text_color = color.gray, text_size = size.small,
             text_halign = text.align_left, bgcolor = bgc)
        table.cell(dash, 1, 4, imbTxt, text_color = color.white, text_size = size.small,
             text_halign = text.align_right, bgcolor = bgc)
